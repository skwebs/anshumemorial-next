# ─── NeonDB (PostgreSQL) ──────────────────────────────────────────────────────
# Go to neon.tech → your project → Connection Details
#
# DATABASE_URL   — pooled connection (pgBouncer) for app runtime queries
# DIRECT_URL     — direct (non-pooled) for Prisma migrations (prisma.config.ts)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Next Auth ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-with-node-crypto-randomBytes-32"
NEXTAUTH_URL="https://anshumemorial.in"

# ─── JWT (mobile API auth) ────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# ─── Public app vars ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://anshumemorial.in"
NEXT_PUBLIC_SCHOOL_NAME="Anshu Memorial Academy"
NEXT_PUBLIC_SCHOOL_PHONE="9128289100"
NEXT_PUBLIC_SCHOOL_EMAIL="info@anshumemorial.in"
NEXT_PUBLIC_SCHOOL_ADDRESS="Bhatha Chowk, Bhatha Dasi, Rajapakar, Vaishali, Bihar-844124"

# ─── Email / SMTP (optional — contact form notifications) ────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="info@anshumemorial.in"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Anshu Memorial Academy <info@anshumemorial.in>"
